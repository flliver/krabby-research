[Unit]
Description=Krabby coturn (STUN/TURN for fleet teleop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Distro package provides /usr/bin/turnserver; our conf lives under
# /etc/krabby-fleet so deploys can rewrite the shared REST-API secret without
# fighting rpm-owned files under /etc/coturn.
ExecStart=/usr/bin/turnserver -c /etc/krabby-fleet/turnserver.conf --pidfile=
Restart=on-failure
RestartSec=5
# Prefer the package user when present; fall back to nobody.
User=turnserver
Group=turnserver
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=krabby-coturn

[Install]
WantedBy=multi-user.target
