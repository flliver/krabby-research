# Example environment for M11 Scene Reconstruction containers.
# Copy this file to .env and fill in real values.  The real .env is gitignored.
#
# Pass to a container at run time:
#   docker run --env-file ./.env --gpus all --shm-size=8g <image>

# HuggingFace access token used by SLAM3R / MASt3R / VGGT to pull gated model
# weights at runtime.  Generate at https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN
