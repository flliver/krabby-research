  "safety_review": [
    {
      "severity": "BLOCKER_FOR_ARMING",
      "topic": "DAC current threshold",
      "details": "U13 DAC7574 outputs through R44/R45/R46 1k to U10/U11/U12 VREF nodes with 100k pull-down R48/R50/R52. Verify DAC I2C address, power-up behavior, VREF->I_TRIP transfer, and write a conservative nonzero current limit before nSLEEP HIGH."
    },
    {
      "severity": "BLOCKER_FOR_ARMING",
      "topic": "Driver modes",
      "details": "DRV8262 MODE1 pin28 pulled up to DVDD by R62/R64/R66, MODE2 pin29 tied GND; selected single H-bridge PH/EN (pin40 phase, pin41 enable). Verify on first hardware and bench-test PH/EN truth table; do not assume PWM interface IN1/IN2."
    },
    {
      "severity": "VERIFY_ON_HARDWARE",
      "topic": "Fault handling",
      "details": "nFAULT active low, pulled up 10k to 3V3, may assert when drivers asleep. Mask fault logic until ready/awake then latch and immediately disarm on any fault."
    },
    {
      "severity": "VERIFY_ON_HARDWARE",
      "topic": "USB clock / connection",
      "details": "USB 48MHz clock tree, VBUS sensing scale, D+ pullup connection and enum not yet validated experimentally."
    },
    {
      "severity": "VERIFY_ON_HARDWARE",
      "topic": "Encoder direction, filtering",
      "details": "M2 encoder signal A maps CH2; sign conventions and RC input filtering require empirical test."
    },
    {
      "severity": "VERIFY_ON_HARDWARE",
      "topic": "Analog acquisition",
      "details": "ADC sample times, source impedances, sensor rails and conversion scaling need measurement; analog levels may be power-domain dependent."
    },
    {
      "severity": "VERIFY_SCHEMATIC",
      "topic": "Schematic vs PCB",
      "details": "This mapping follows extracted PCB pad nets; full independent 15-sheet schematic-to-PCB LVS not performed."
    },
    {
      "severity": "VERIFY_STARTUP",
      "topic": "BOOT0 option bytes",
      "details": "PB8 externally low 100k except button to 3V3; confirm nBOOT0 option bytes and documented boot behavior."
    },
    {
      "severity": "IMPORTANT_OPERATING_SEMANTICS",
      "topic": "0% duty vs motor coast",
      "details": "In PH/EN mode, IN1=0 causes high-side braking when nSLEEP=1. It is not high-impedance/coast. For true Hi-Z use nSLEEP=0 (subject to specified wake latency). PWM startup safe only while nSLEEP remains 0."
    }
  ],
