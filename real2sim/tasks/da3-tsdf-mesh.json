{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/da3-tsdf-mesh/v1",
  "title": "da3-tsdf-mesh",
  "description": "Open3D TSDF fusion over DA3 conf-thresholded depths + poses -> mesh, similarity-aligned into the scene's oriented frame (gauge_align over shared cameras; gate residual <=10% of camera spread). Writes the standard tsdf mesh-source path. CPU-only, seconds.",
  "x-task": {
    "kind": "mesh",
    "phase": 13,
    "operator": false,
    "image": "j.pski.org:5000/krabby-da3:0.4",
    "entrypoint": "/opt/krabby-tools/da3_tsdf_mesh.py --scene --matcha-run --da3-run [...]",
    "code_ref": "real2sim/da3_tsdf_mesh.py",
    "story": "EPI-SCN-FEEDFORWARD-RECON",
    "inputs": [
      {
        "name": "npz",
        "pattern": "**/data/exports/npz/results.npz"
      },
      {
        "name": "anchor_cameras",
        "pattern": "<matcha-run>/**/{mast3r_sfm/cameras.json,oriented/oriented_cameras.json}"
      }
    ],
    "outputs": [
      {
        "name": "mesh",
        "pattern": "**/data/tsdf_meshes/multires_tsdf_post_oriented.ply"
      },
      {
        "name": "record",
        "pattern": "**/data/tsdf_meshes/fusion_record.json"
      }
    ],
    "produces_variables": [
      "alignment_scale",
      "alignment_residual"
    ]
  },
  "type": "object",
  "properties": {
    "voxel_frac": {
      "type": "number",
      "default": 0.004,
      "description": "voxel = voxel_frac x 95pct depth span; only 0.004 validated; bounds unmeasured (T-002) \u2014 extend with evidence, don't invent"
    },
    "conf_percentile": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 40,
      "description": "depth-confidence threshold percentile; bounds sourced from percentile semantics"
    }
  },
  "required": [],
  "additionalProperties": false
}
