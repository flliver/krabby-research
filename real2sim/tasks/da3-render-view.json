{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/da3-render-view/v1",
  "title": "da3-render-view",
  "description": "Render a saved scene view from DA3 gaussians: gauge-aligns DA3->oriented frame (auto-verifies w2c/c2w by residual), maps the schema-5 view, renders via run_renderer_in_chunk_w_trj_mode. Alignment gate <=10% of camera spread.",
  "x-task": {
    "kind": "evaluation",
    "phase": 13,
    "operator": false,
    "image": "j.pski.org:5000/krabby-da3:0.4",
    "entrypoint": "/opt/krabby-tools/da3_render_view.py",
    "code_ref": "real2sim/da3_render_view.py",
    "story": "STO-SCN-061",
    "inputs": [
      {
        "name": "gaussians",
        "pattern": "**/data/exports/gs_ply/**"
      },
      {
        "name": "view",
        "pattern": "cameras.json"
      }
    ],
    "outputs": [
      {
        "name": "render",
        "pattern": "pipeline-da3/run-*/renders/<view>.png"
      }
    ],
    "produces_variables": []
  },
  "type": "object",
  "properties": {
    "residual_gate_frac": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.1,
      "description": "refuse render when alignment residual exceeds this fraction of camera spread; 006 measured 2.9%"
    }
  },
  "required": [],
  "additionalProperties": false
}
