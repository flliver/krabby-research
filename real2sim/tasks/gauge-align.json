{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/gauge-align/v1",
  "title": "gauge-align",
  "description": "Orientation-augmented Umeyama similarity alignment between camera sets (used by photo-spine stitch and all DA3->oriented mappings). Gate: max residual <= gate_frac of camera spread.",
  "x-task": {
    "kind": "alignment",
    "phase": 6,
    "operator": false,
    "image": null,
    "entrypoint": "real2sim/gauge_align.py (library: align_camera_sets)",
    "code_ref": "real2sim/gauge_align.py",
    "story": "STO-SCN-050",
    "inputs": [
      {
        "name": "src_cameras",
        "pattern": "(caller-supplied camera sets)"
      },
      {
        "name": "dst_cameras",
        "pattern": "(caller-supplied camera sets)"
      }
    ],
    "outputs": [
      {
        "name": "similarity",
        "pattern": "(scale, R, t + residuals \u2014 caller records)"
      }
    ],
    "produces_variables": [
      "scale",
      "R",
      "t",
      "max_residual"
    ]
  },
  "type": "object",
  "properties": {
    "gate_frac": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.1,
      "description": "alignment acceptance gate as fraction of camera spread; 006 DA3<->matcha measured 2.9%"
    }
  },
  "required": [],
  "additionalProperties": false
}
