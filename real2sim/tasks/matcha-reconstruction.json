{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/matcha-reconstruction/v1",
  "title": "matcha-reconstruction",
  "description": "MAtCha full pipeline (SfM unposed -> charts -> refine -> tetra) via the spec-driven runner: verified flag mappings, image-label mounts, digest provenance, expected-outputs hard gate, LFS-pointer input guard.",
  "x-task": {
    "kind": "reconstruction",
    "phase": 7,
    "operator": false,
    "image": "j.pski.org:5000/krabby-matcha:0.2.2-selfcontained",
    "entrypoint": "python3 real2sim/run_transform.py <run-dir>",
    "code_ref": "real2sim/run_transform.py",
    "story": "STO-SCN-039 (runner), STO-SCN-038/053 (image)",
    "inputs": [
      {
        "name": "images",
        "pattern": "input/src | input/preproc-NN-*/data"
      }
    ],
    "outputs": [
      {
        "name": "cameras",
        "pattern": "**/data/mast3r_sfm/cameras.json"
      },
      {
        "name": "gaussians",
        "pattern": "**/data/free_gaussians/**"
      },
      {
        "name": "tetra_mesh",
        "pattern": "**/data/tetra_meshes/tetra_mesh_binary_search_*.ply"
      }
    ],
    "produces_variables": [
      "cams2world"
    ]
  },
  "type": "object",
  "properties": {
    "alignment_config": {
      "type": "string",
      "enum": [
        "strong"
      ],
      "default": "strong",
      "description": "only 'strong' validated; other configs exist upstream but are unverified here"
    },
    "dense_regul": {
      "type": "string",
      "enum": [
        "default",
        "dense"
      ],
      "default": "default",
      "description": "flag mapping verified against train.py (commit c073e15)"
    },
    "dense_pruning": {
      "type": "string",
      "enum": [
        "default"
      ],
      "default": "default"
    },
    "encoder": {
      "type": "string",
      "enum": [
        "vitl"
      ],
      "default": "vitl"
    },
    "sfm_config": {
      "type": "string",
      "enum": [
        "unposed"
      ],
      "default": "unposed"
    },
    "n_images": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "description": "max = SfM solve ceiling (measured); >=17 cams needs image >=0.2.2 (multires OOM patch)"
    },
    "extra_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "alignment_config",
    "n_images"
  ],
  "additionalProperties": false
}
