{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/camera-save/v1",
  "title": "camera-save",
  "description": "OPERATOR task (T-020): frame a view in the run scene.blend viewport, /camera-save captures it (TRUE lens from projection matrix) and regenerates scene-level cameras.json (schema 5). VERIFY the result names the scene you meant \u2014 a stale Blender can hold the MCP port (2026-06-10 incident).",
  "x-task": {
    "kind": "evaluation",
    "phase": 10,
    "operator": true,
    "image": null,
    "entrypoint": "/camera-save <view-name> [purpose]",
    "code_ref": "real2sim/viewport_capture.py + real2sim/sync_comparison_views.py",
    "story": "STO-SCN-046 (skill), STO-SCN-045 (schema)",
    "inputs": [
      {
        "name": "blend",
        "pattern": "pipeline-*/run-*/scene.blend"
      }
    ],
    "outputs": [
      {
        "name": "views",
        "pattern": "cameras.json"
      }
    ],
    "produces_variables": [
      "view_name"
    ]
  },
  "type": "object",
  "properties": {
    "view_name": {
      "type": "string",
      "description": "named virtual camera"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "ab-comparison",
        "reference-match"
      ],
      "default": "ab-comparison"
    }
  },
  "required": [
    "view_name"
  ],
  "additionalProperties": false
}
