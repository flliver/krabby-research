{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/photo-spine/v1",
  "title": "photo-spine",
  "description": "Pools >300 frames: chunked SfM solves + gauge stitching (consensus align, relative gates). Split per capture session FIRST \u2014 blind chunking across session boundaries broke 005 chunk-01. Cross-session merge not built.",
  "x-task": {
    "kind": "preprocessing",
    "phase": 6,
    "operator": false,
    "image": "j.pski.org:5000/krabby-matcha:0.2.2-selfcontained",
    "entrypoint": "python3 real2sim/batched_sfm.py chunk|solve|stitch",
    "code_ref": "real2sim/batched_sfm.py + real2sim/gauge_align.py",
    "story": "STO-SCN-048/049/050/051 (epic sparse/epic-photo-spine-pipeline; parked)",
    "inputs": [
      {
        "name": "photo_pool",
        "pattern": "input/src"
      }
    ],
    "outputs": [
      {
        "name": "stitched_poses",
        "pattern": "input/spine-NN/**/cameras.json"
      }
    ],
    "produces_variables": [
      "chunk_manifest"
    ]
  },
  "type": "object",
  "properties": {
    "chunk_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 300,
      "description": "max = measured solve ceiling"
    },
    "overlap": {
      "type": "integer",
      "minimum": 0,
      "default": 50,
      "description": "bounds unmeasured (T-002) \u2014 extend with evidence, don't invent"
    }
  },
  "required": [],
  "additionalProperties": false
}
