{
  "schema": 4,
  "name": "meshify-via-tsdf",
  "algo": "tsdf-extract@0",
  "description": "TSDF mesh. Accepts gaussians (matcha path) or depths (da3 fusion).",
  "inputs": [
    {
      "name": "representation",
      "from": "represent",
      "kind": "gaussians|depths"
    },
    {
      "name": "cameras",
      "binding": "solve identity"
    }
  ],
  "settings": {
    "mesh_res": {
      "class": "tunable",
      "default": 1024,
      "note": "1024 validated; other values unmeasured"
    },
    "config": {
      "class": "frozen",
      "enum": [
        "default"
      ],
      "default": "default",
      "note": "lowmem measured-worse -> pin-by-verdict"
    }
  },
  "placement": "represent/{up_represent_kindpath}/meshify/tsdf/{identity}",
  "outputs": [
    {
      "name": "mesh",
      "path": "mesh.ply"
    }
  ],
  "tolerances": {
    "verts_rel": 0.0005,
    "tris_rel": 0.0005,
    "$comment": "derived (T-017): same-host variance 8-giant-studio vs -var1: verts 0.0037%, tris 0.0053% -> ~10x gate"
  }
}
