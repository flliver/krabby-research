{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/pool-sfm/v1",
  "title": "pool-sfm",
  "description": "Camera positioning: MASt3R-SfM --sfm_only solve over the candidate pool so frames can be curated by WHERE they are ('the dtu flow', Recipe A step 4). GPU host.",
  "x-task": {
    "kind": "preprocessing",
    "phase": 4,
    "operator": false,
    "image": "j.pski.org:5000/krabby-matcha:0.2.2-selfcontained",
    "entrypoint": "python3 real2sim/batched_sfm.py chunk+solve (single chunk)",
    "code_ref": "real2sim/batched_sfm.py",
    "story": "STO-SCN-055",
    "inputs": [
      {
        "name": "candidate_pool",
        "pattern": "input/preproc-NN-*/data"
      }
    ],
    "outputs": [
      {
        "name": "poses",
        "pattern": "input/preproc-NN-pool-sfm/data/**/cameras.json"
      }
    ],
    "produces_variables": [
      "cams2world"
    ]
  },
  "type": "object",
  "properties": {
    "chunk_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 300,
      "description": "max = measured 16GB solve ceiling"
    },
    "overlap": {
      "type": "integer",
      "minimum": 0,
      "default": 50,
      "description": "frames shared between chunks; 50 validated; bounds unmeasured (T-002) \u2014 extend with evidence, don't invent"
    }
  },
  "required": [],
  "additionalProperties": false
}
