      {
        "name": "oriented_mesh",
        "pattern": "**/data/oriented/oriented_tetra.ply"
      },
      {
        "name": "cameras",
        "pattern": "**/data/mast3r_sfm/cameras.json"
      }
    ],
    "outputs": [
      {
        "name": "blend",
        "pattern": "pipeline-*/run-*/scene.blend"
      }
    ],
    "produces_variables": []
  },
  "type": "object",
  "properties": {},
  "required": [],
  "additionalProperties": false
