{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/build-blender-scene/v1",
  "title": "build-blender-scene",
  "description": "Headless Blender scene build: oriented tetra mesh + vertex-color material + camera objects + image empties -> run-<r>/scene.blend (untracked; regenerable).",
