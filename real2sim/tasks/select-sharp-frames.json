{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/select-sharp-frames/v1",
  "title": "select-sharp-frames",
  "description": "Blur-aware subsample: variance-of-Laplacian @score_edge px, sharpest frame per `count` uniform temporal windows. Builds candidate pools and quick baselines. Coverage-blind \u2014 never the scene's FINAL selection (001 lesson).",
  "x-task": {
    "kind": "preprocessing",
    "phase": 3,
    "operator": false,
    "image": null,
    "entrypoint": "python3 real2sim/select_sharp_frames.py <preproc-dir>",
    "code_ref": "real2sim/select_sharp_frames.py",
    "story": "STO-SCN-052",
    "inputs": [
      {
        "name": "frame_pool",
        "pattern": "input/src"
      }
    ],
    "outputs": [
      {
        "name": "selected",
        "pattern": "input/preproc-NN-*/data/*.png"
      },
      {
        "name": "scores",
        "pattern": "input/preproc-NN-*/results.json#selected_idx"
      }
    ],
    "produces_variables": [
      "selected_idx",
      "scores"
    ]
  },
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 200,
      "description": "max = MASt3R-SfM solve ceiling ~300 frames/16GB (measured, 005 OOM @400-500); 200 is the proven pool size"
    },
    "score_edge": {
      "type": "integer",
      "default": 480,
      "description": "scoring resolution; only 480 validated; bounds unmeasured (T-002) \u2014 extend with evidence, don't invent"
    },
    "selection_method": {
      "type": "string",
      "enum": [
        "windowed-sharpest-laplacian"
      ],
      "default": "windowed-sharpest-laplacian"
    }
  },
  "required": [
    "count"
  ],
  "additionalProperties": false
}
