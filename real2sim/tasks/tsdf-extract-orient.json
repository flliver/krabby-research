{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:task/tsdf-extract-orient/v1",
  "title": "tsdf-extract-orient",
  "description": "TSDF mesh extraction (in-image, config `default` \u2014 lowmem visibly degrades: 001's 320MB vs 1351MB) + gravity orientation (RANSAC floor). Gate on output FRESHNESS, not existence \u2014 os.system swallows rc. Needs PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True.",
  "x-task": {
    "kind": "mesh",
    "phase": 8,
    "operator": false,
    "image": "j.pski.org:5000/krabby-matcha:0.2.2-selfcontained",
    "entrypoint": "scripts/extract_tsdf_mesh.py -> orient_mesh.py / apply_existing_orientation.py",
    "code_ref": "real2sim/orient_mesh.py",
    "story": "STO-SCN-056 (orient: STO-SCN-004)",
    "inputs": [
      {
        "name": "sfm",
        "pattern": "**/data/mast3r_sfm"
      },
      {
        "name": "gaussians",
        "pattern": "**/data/free_gaussians"
      }
    ],
    "outputs": [
      {
        "name": "oriented_tsdf",
        "pattern": "**/data/tsdf_meshes/multires_tsdf_post_oriented.ply"
      },
      {
        "name": "oriented_tetra",
        "pattern": "**/data/oriented/oriented_tetra.ply"
      },
      {
        "name": "orientation",
        "pattern": "**/data/oriented/oriented_cameras.json"
      }
    ],
    "produces_variables": [
      "rotation",
      "z_shift"
    ]
  },
  "type": "object",
  "properties": {
    "config": {
      "type": "string",
      "enum": [
        "default",
        "lowmem"
      ],
      "default": "default",
      "description": "lowmem deprecated for deliverables (measured quality loss)"
    },
    "mesh_res": {
      "type": "integer",
      "default": 1024,
      "description": "factors [2,8,16] at 1024 validated; bounds unmeasured (T-002) \u2014 extend with evidence, don't invent"
    }
  },
  "required": [],
  "additionalProperties": false
}
