{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krabby:scene-schema/results",
  "title": "results.json — HOW/WHERE a transform ran",
  "type": "object",
  "required": ["schema_version", "transform", "status", "provenance", "environment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "transform": { "type": "string", "pattern": "^transform-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "status": { "enum": ["success", "failed", "partial"] },
    "provenance": { "enum": ["measured", "deduced", "unknown"] },
    "started": { "type": ["string", "null"] },
    "finished": { "type": ["string", "null"] },
    "duration_s": { "type": ["number", "null"], "minimum": 0 },
    "host": { "type": ["string", "null"] },
    "peak_vram_mib": { "type": ["number", "null"], "minimum": 0 },
    "environment": {
      "type": "object",
      "required": ["os", "gpu", "container"],
      "additionalProperties": true,
      "properties": {
        "os": { "type": "string" },
        "gpu": { "type": "string" },
        "nvidia_driver": { "type": "string" },
        "cuda": { "type": "string" },
        "container": {
          "type": "object",
          "required": ["image", "digest"],
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string", "description": "ECR repo URI or local image name" },
            "tag": { "type": "string", "description": "M14 scheme: commit-SHA | <branch>-latest | semver" },
            "digest": { "type": "string", "description": "sha256:… — the reproducibility anchor; 'unknown' if unrecoverable" }
          }
        },
        "software": { "type": "object" }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "comment": "measured provenance requires real runtime detail; deduced/unknown may carry 'unknown' strings",
      "if": { "properties": { "provenance": { "const": "measured" } } },
      "then": { "required": ["host"] }
    }
  ]
}
