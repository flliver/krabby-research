{
  "schema": 4,
  "name": "ingest-scene",
  "description": "Idempotent scene bootstrap (locked #7): safe to run any time; refs set-if-unset.",
  "nodes": [
    {
      "id": "extract",
      "task": "video-to-images",
      "optional": true
    },
    {
      "id": "pool",
      "task": "images-subset"
    },
    {
      "id": "capture-profile",
      "task": "resolve-capture-profile"
    },
    {
      "id": "precull",
      "task": "precull-subset",
      "optional": true,
      "note": "STO-SCN-092 opt-in side-branch: derives a curated subset from the pool; not in the default solve path (primary unchanged unless --set-primary)."
    },
    {
      "id": "solve",
      "task": "solve-cameras"
    },
    {
      "id": "orient",
      "task": "orient-cameras"
    },
    {
      "id": "views",
      "task": "generate-views"
    }
  ],
  "edges": [
    [
      "extract",
      "pool"
    ],
    [
      "pool",
      "capture-profile"
    ],
    [
      "pool",
      "precull"
    ],
    [
      "capture-profile",
      "solve"
    ],
    [
      "solve",
      "orient"
    ],
    [
      "orient",
      "views"
    ]
  ]
}
