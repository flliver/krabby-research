// krabby multi-root workspace — generated by `ccc-bd vscode-template emit`.
//
// Why this file exists
// --------------------
// VSCode's FileSystemWatcher only fires for paths inside the
// "workspace folder(s)" that VSCode considers active. In a single-
// root mount (`code /var/krabby/workspace`), the workspace
// folder is just `workspace/` — but most CCC projects span multiple
// sibling dirs (`messages/`, `inbox/`, peer repos). Without telling
// VSCode about them, fs-watch coverage stops at the workspace
// boundary; STO-ONB-004's FLOW SSE channel + STO-ONB-011's
// ccc-combine surface discovery pick up the slack server-side, but
// the Explorer pane doesn't see those dirs.
//
// This multi-root workspace file declares every peer_root from
// `.ccc/settings.json#peer_roots[]` as an additional VSCode
// workspace folder, so:
//
//   - The Explorer shows all peer dirs as siblings of `workspace/`.
//   - STO-ONB-012's cccBdWatchers.ts walks each in-workspace
//     peer_root with explicit per-root RelativePattern watchers
//     (fastest possible pane refresh — no SSE round-trip).
//   - Mutations under peer dirs trigger fs-events VSCode can act on.
//
// Regenerating
// ------------
// To pick up changes you've made to `.ccc/settings.json` (added a
// peer_root, renamed the project, etc.), re-emit:
//
//     ccc-bd vscode-template emit --force
//
// The emitter is idempotent for unchanged settings. `--force` is
// required because operators routinely hand-edit this file (extra
// extensions, custom excludes); the emitter never silently
// clobbers — pass `--force` only when you intend to drop those
// edits.
//
// Operators who prefer single-root mode can keep using
// `code <workspace>` directly — peer_roots[] still flows through
// STO-ONB-004 (SSE) + STO-ONB-011 (ccc-combine FTS5 indexing) + the
// file_watchers globs from STO-ONB-006. Pane refresh works either
// way; the multi-root path is purely a fast-watch + unified-
// Explorer convenience.
//
// References:
//   - HUG-ONB-002 §"VSCode mount strategy is per-operator"
//   - STO-ONB-012 (cccBdWatchers.ts is the consumer-side counterpart)
//   - .ccc/settings.json#peer_roots[] (the declarative source of truth)
//   - STO-ONB-036 (this emitter)
{
  // ── Folders ──────────────────────────────────────────────────
  // Order matters for the Explorer's visual sort. Convention:
  // workspace first (the "primary" repo), peer_roots after in the
  // same order as `.ccc/settings.json#peer_roots[]`.
  "folders": [
    {
      "name": "🤖 krabby (workspace)",
      "path": "/private/var/krabby/research"
    },
    {
      "name": "🤖 real2sim",
      "path": "../real2sim"
    },
    {
      "name": "🤖 parkour",
      "path": "../parkour"
    },
    {
      "name": "🤖 firmware",
      "path": "../firmware"
    },
    {
      "name": "🤖 messages",
      "path": "../messages"
    },
    {
      "name": "🤖 inbox",
      "path": "../inbox"
    },
    {
      "name": "🤖 cache",
      "path": "../cache"
    },
    {
      "name": "🤖 projects",
      "path": "../projects"
    },
    {
      "name": "🤖 grants",
      "path": "../../grants"
    },
    {
      "name": "🤖 contracts",
      "path": "../../contracts"
    },
    {
      "name": "🤖 legacy",
      "path": "../../workspace"
    },
  ],

  // ── Workspace-scoped settings ────────────────────────────────
  // These apply only when the workspace is opened via this file.
  // Per-operator preferences (font, theme, keybindings, etc.)
  // belong in user-level VSCode settings, not here.
  "settings": {
    // Opt into the ccc-delegates extension's ccc-combine read backend.
    // When true + ccc-combine reachable at 127.0.0.1:cccCombinePort,
    // panes read from /state/SSE (fast, FTS5-backed).
    "ccc.useCccCombineApi": true,
    "ccc.cccCombinePort": 7158,

    // Peacock — visual identifier for this project's window so
    // multiple open CCC projects don't blur together. Color is
    // derived deterministically from the project name (same name
    // always picks the same palette entry) unless settings.json
    // sets `peacock_color` explicitly.
    "peacock.color": "#1d3557",

    // Hide noise dirs from the Explorer's file tree.
    "files.exclude": {
      "**/.beads": true,
      "**/.dolt": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/node_modules": true
    },

    // Hide the same dirs from search results.
    "search.exclude": {
      "**/.beads": true,
      "**/.dolt": true,
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/out": true,
      "**/dist": true
    },
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#2a4c7d",
      "activityBar.background": "#2a4c7d",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#c75885",
      "activityBarBadge.foreground": "#e7e7e7",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#2a4c7d",
      "statusBar.background": "#1d3557",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#2a4c7d",
      "statusBarItem.remoteBackground": "#1d3557",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#1d3557",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#1d355799",
      "titleBar.inactiveForeground": "#e7e7e799"
    },
    "ccc.delegates.pinned": [
      "krabby-krabby",
      "krabby-ccc"
    ]
  },

  // ── Recommended extensions ───────────────────────────────────
  // VSCode prompts to install these the first time the workspace
  // opens. The ccc-delegates extension is required for the pane
  // surfaces (Effort / Milestones / Ready / HUGs / Goals); add
  // language extensions per-operator preference, not here.
  "extensions": {
    "recommendations": [
      "ccc.ccc-delegates"
    ]
  }
}
